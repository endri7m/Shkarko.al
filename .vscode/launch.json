{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Debug Backend API",
      "runtimeExecutable": "${workspaceFolder}/.node/node.exe",
      "runtimeArgs": [
        "${workspaceFolder}/node_modules/ts-node-dev/lib/bin.js",
        "--respawn",
        "--transpile-only"
      ],
      "args": ["src/index.ts"],
      "cwd": "${workspaceFolder}/apps/backend",
      "skipFiles": ["<node_internals>/**"],
      "console": "integratedTerminal"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Debug Worker",
      "runtimeExecutable": "${workspaceFolder}/.node/node.exe",
      "runtimeArgs": [
        "${workspaceFolder}/node_modules/ts-node-dev/lib/bin.js",
        "--respawn",
        "--transpile-only"
      ],
      "args": ["src/index.ts"],
      "cwd": "${workspaceFolder}/apps/worker",
      "skipFiles": ["<node_internals>/**"],
      "console": "integratedTerminal"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Debug Next.js Server",
      "runtimeExecutable": "${workspaceFolder}/.node/npm.cmd",
      "runtimeArgs": [
        "run",
        "dev:frontend"
      ],
      "skipFiles": ["<node_internals>/**"],
      "console": "integratedTerminal"
    },
    {
      "type": "chrome",
      "request": "launch",
      "name": "Debug Next.js Client (Chrome)",
      "url": "http://localhost:3000",
      "webRoot": "${workspaceFolder}/apps/frontend"
    }
  ],
  "compounds": [
    {
      "name": "Debug Full Stack (All Services)",
      "configurations": [
        "Debug Backend API",
        "Debug Worker",
        "Debug Next.js Server",
        "Debug Next.js Client (Chrome)"
      ]
    }
  ]
}