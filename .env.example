# ==============================================================================
# SonicFlow Environment Configuration Template
# ==============================================================================

# Node Environment
NODE_ENV=development

# Backend API Configuration
PORT=5000

# PostgreSQL Database Settings
# Replace with production values when deploying to external servers
DATABASE_URL=postgresql://sonicflow_user:sonicflow_password@localhost:5432/sonicflow?sslmode=disable

# Redis Queue & Rate Limiter Configuration
REDIS_URL=redis://localhost:6379

# Object Storage S3 Settings
# Use localhost in local dev, or minio inside docker networks, or amazonaws in production
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=sonicflow-bucket
S3_REGION=us-east-1
